{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "bash",
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/validate-bash.sh",
            "timeout": 10,
            "enabled": true,
            "statusMessage": "Checking for production dbt commands..."
          }
        ]
      }
    ]
  }
}
